# Переменные для запуска backend БЕЗ docker (uvicorn локально).
# Скопируйте в backend/.env и заполните. При запуске через docker compose
# этот файл не нужен — значения берутся из корневого .env.

# Строка подключения к PostgreSQL (драйвер psycopg v3), например:
# postgresql+psycopg://<user>:<password>@localhost:5434/tms
DATABASE_URL=

# Обязательно задать своё значение (openssl rand -hex 32) — без него
# backend не запустится.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

SUPERADMIN_EMAIL=admin@system.local
SUPERADMIN_PASSWORD=

# MinIO: host:port API (без схемы) и публичный URL
MINIO_URL=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=tms-attachments
MINIO_PUBLIC_URL=http://localhost:9000
