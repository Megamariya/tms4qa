# ─────────────────────────────────────────────────────────────────────────
# TMS4QA — переменные окружения для docker compose.
# Скопируйте этот файл в .env и заполните значения:  cp .env.example .env
# Файл .env в Git НЕ коммитится (см. .gitignore).
# ─────────────────────────────────────────────────────────────────────────

# Имя compose-проекта (префикс контейнеров/томов). Меняйте, чтобы поднять
# несколько независимых копий стека на одной машине.
COMPOSE_PROJECT_NAME=tms4qa

# Часовой пояс контейнеров (например, Europe/Moscow). По умолчанию UTC.
TZ=UTC

# ── Порты на хосте ───────────────────────────────────────────────────────
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5434
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=postgres
# Обязательно. Пароль БД (DATABASE_URL для backend собирается автоматически)
POSTGRES_PASSWORD=
POSTGRES_DB=tms

# ── Аутентификация (JWT) ─────────────────────────────────────────────────
# Обязательно. Длинная случайная строка, например: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Супер-администратор, создаётся при первом старте backend
SUPERADMIN_EMAIL=admin@system.local
# Обязательно. Пароль супер-администратора
SUPERADMIN_PASSWORD=

# ── MinIO (хранилище вложений) ──────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
# Обязательно. Минимум 8 символов
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=tms-attachments
